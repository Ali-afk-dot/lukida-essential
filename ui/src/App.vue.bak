        <p class="text-sm opacity-70">{{ getAuthor(item) }}</p>
        <p class="text-xs opacity-50">{{ item.year || '' }}{{ item.year && item.format && item.format !== 'unknown' ? ' · ' : '' }}{{ item.format !== 'unknown' ? item.format || '' : '' }}</p>
      </div>

Warte — das wäre zu lang für PuTTY. Besser so:

bash
# Dateien direkt von meiner Seite laden — ich erstell dir ein Deploy-Skript
cat > /tmp/deploy_lukida.sh << 'EOF'
#!/bin/bash
set -e
COMP=/home/ali/lukida-light/ui/src/components
SRC=/home/ali/lukida-light/ui/src

# Backup
cp $COMP/Modal.vue $COMP/Modal.vue.bak 2>/dev/null || true
cp $COMP/Navbar.vue $COMP/Navbar.vue.bak 2>/dev/null || true
cp $SRC/App.vue $SRC/App.vue.bak 2>/dev/null || true

echo "Backup erstellt"
EOF
